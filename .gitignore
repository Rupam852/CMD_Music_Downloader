# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Local environment & virtualenvs
.venv/
venv/
env/
ENV/

# Large binary files & tools (auto-downloaded by script)
bin/
*.zip
*.tar.gz
*.exe

# Downloaded music & media output folders
downloads/
temp/
*.mp3
*.flac
*.wav
*.m4a
*.webm
*.webp

# Gradle files & Android build outputs
.gradle/
build/
app/build/
*.apk
*.aab
